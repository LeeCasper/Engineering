# 依赖
node_modules/
.pnpm-store/

# 环境变量（含数据库密码、JWT 密钥、微信凭据，绝不入库）
.env
.env.local
.env.*.local
# 例外：管理后台的 Vite 变量全部是前端公开配置（成功码、路由模式、标题），
# 不含任何密钥，且缺了它仓库构建出来就是坏的 —— 必须入库。
!admin/.env

# 上传的文件（本地存储适配器）
server/uploads/
!server/uploads/.gitkeep

# 电子签私有证据（已签 PDF、证据报告；绝不入库/入镜像）
server/private-esign/
server/private-esign-test/

# 构建产物
# 注意：`admin/build/` 是**源码目录**（vite.config.ts 从这里 import 插件与配置），
# 不能被 `build/` 这种通配规则忽略，否则新克隆的仓库根本构建不了。
# 这里只忽略仓库根目录下的构建输出。
dist/
/build/
unpackage/
.output/

# 日志
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# 测试与覆盖率
coverage/
.nyc_output/
tests/.tmp/

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# 临时文件
*.tmp
*.swp
