# 依赖
node_modules/
.pnpm-store/

# 环境变量（含数据库密码、JWT 密钥、微信凭据，绝不入库）
.env
.env.local
.env.*.local
# 例外：管理后台的 Vite 变量全是会打进前端包的公开值，不含密钥；
# 缺了它新克隆的仓库连 vite 配置都加载不了（VITE_ICON_PREFIX 未定义）
!admin/.env

# 上传的文件（本地存储适配器）
server/uploads/
!server/uploads/.gitkeep

# 电子签私有证据（已签 PDF、证据报告；绝不入库/入镜像）
server/private-esign/
server/private-esign-test/

# 构建产物
dist/
# 只忽略仓库根目录的 build/；admin/build/ 是 Vite 的构建配置源码，必须入库
/build/
unpackage/
.output/

# 日志
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# 测试与覆盖率
coverage/
.nyc_output/
tests/.tmp/

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# 临时文件
*.tmp
*.swp
