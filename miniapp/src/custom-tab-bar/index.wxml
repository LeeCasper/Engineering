<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item"
    data-index="{{index}}"
    bindtap="onTap"
  >
    <view class="icon-wrap">
      <image class="icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
      <text wx:if="{{index === 3 && badge > 0}}" class="badge">{{badge > 99 ? '99+' : badge}}</text>
    </view>
    <text class="label {{selected === index ? 'label--active' : ''}}">{{item.text}}</text>
  </view>
</view>
