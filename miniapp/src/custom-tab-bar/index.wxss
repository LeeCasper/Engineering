/* 微信原生自定义底栏：位置、高度对齐原生 tabBar；材质与 C 端一致 */
.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-start;
  padding: 5px 6px;
  padding-bottom: calc(5px + constant(safe-area-inset-bottom));
  padding-bottom: calc(5px + env(safe-area-inset-bottom));
  border-top: 1px solid rgba(255, 255, 255, 0.72);
  background: linear-gradient(
    180deg,
    rgba(250, 247, 244, 0.72) 0%,
    rgba(255, 255, 255, 0.84) 100%
  );
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  box-shadow:
    0 -2px 16px rgba(29, 33, 41, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.92);
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  padding-top: 1px;
}

.icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 25px;
}

.icon {
  width: 24px;
  height: 24px;
}

.badge {
  position: absolute;
  top: -3px;
  right: -6px;
  box-sizing: border-box;
  min-width: 15px;
  height: 15px;
  padding: 0 4px;
  border: 1px solid #fff;
  border-radius: 999px;
  background: #f53f3f;
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  line-height: 13px;
  text-align: center;
}

.label {
  margin-top: 2px;
  color: #8b8179;
  font-size: 10px;
  line-height: 1.25;
}

.label--active {
  color: #eb5c20;
  font-weight: 600;
}
