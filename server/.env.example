# =====================================================================
# 工程宝 · 后端服务环境变量
#
# 复制为 .env 后按需修改。.env 已在 .gitignore 中，不会被提交。
# 本文件是**唯一**的环境变量入口，业务代码一律通过 config/index.js 读取，
# 不允许在 src/ 下直接出现 process.env（见 CLAUDE.md「关键约束」）。
# =====================================================================

# ===== 运行环境 =====
# development | test | production
NODE_ENV=development
PORT=3000
# 全局路由前缀，对应需求文档 §7.1
API_PREFIX=/api/v1

# ===== MySQL =====
# 需求文档 §3.2 指定 MySQL 8.0。
# decimalNumbers 在代码层固定为 false（DECIMAL 以字符串返回），
# 避免金额落进 JS Number 产生精度丢失（AC-L11），此处无需配置。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=renovation
DB_PASSWORD=
DB_NAME=renovation_dev
# 测试库（NODE_ENV=test 时自动切换到这里，集成测试会清空重建）
DB_NAME_TEST=renovation_test
DB_POOL_LIMIT=10
DB_TIMEZONE=+08:00

# ===== Redis =====
# 需求文档 §3.2 指定 Redis 承担登录态、验证码、消息去重。
# CACHE_DRIVER=memory 时完全绕过 Redis（本机没装 Redis 也能跑）。
CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 键前缀，避免与同机其他项目串键
REDIS_PREFIX=renovation:

# ===== JWT =====
# 需求文档 §7.1：C 端与 B 端使用不同的签发策略，互不通用（AC-AD10）。
# 两个密钥必须不同，否则 token 可跨端复用，鉴权分流形同虚设。
# 生产环境务必替换为随机值：openssl rand -hex 32
JWT_MINI_SECRET=dev-only-mini-secret-change-me
JWT_ADMIN_SECRET=dev-only-admin-secret-change-me
JWT_MINI_EXPIRES=7d
JWT_ADMIN_EXPIRES=8h
# 后台空闲超时：超过该时长无请求则 token 失效（B-1.7）
JWT_ADMIN_IDLE=30m

# ===== 微信小程序 =====
# 微信静默登录需要 AppID + Secret。本地开发没有凭据，
# WX_MOCK=true 时跳过 code2session，直接用 code 派生一个稳定的 openid，
# 使后端全链路（含集成测试、冒烟脚本）可在无微信环境跑通。
# 真机联调前置为 false 并填入真实凭据。
WX_APPID=
WX_SECRET=
WX_MOCK=true

# ===== 文件上传 =====
# 本地磁盘存储。V1.1 起可切换为腾讯云 COS / 阿里云 OSS（storage adapter）。
UPLOAD_DIR=./uploads
# 生成可访问 URL 用的外部基址（图片水印后返回给前端）
PUBLIC_BASE_URL=http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=10

# ===== 限流 =====
# 需求文档 §8.2：单用户 60 次/分钟
RATE_LIMIT_PER_MINUTE=60

# ===== 安全 =====
# bcrypt 的 cost。默认 10（约 45ms/次）。
# 调高更安全但会拖慢登录接口 P95（§8.1 要求 ≤500ms）；调低会让离线爆破成本下降。
# 生产环境若低于 BCRYPT_ROUNDS_MIN，进程会**拒绝启动**。
BCRYPT_ROUNDS=10
BCRYPT_ROUNDS_MIN=10
# 测试环境专用的低 cost。集成测试里有上千次登录，cost=10 会吃掉一分钟以上。
# 它不影响哈希格式与校验结果，因此不削弱对密码逻辑的覆盖。
BCRYPT_ROUNDS_TEST=4

# 带签临时链接的密钥（验收报告 PDF 下载用，AC-A20）。
# 生产务必替换：openssl rand -hex 32
# 刻意不复用 JWT 密钥——两者的暴露面不同（签名 URL 会出现在可转发的链接里）
SIGNED_URL_SECRET=dev-only-signed-url-secret-change-me
SIGNED_URL_TTL_SECONDS=7200

# ===== 中文字体 =====
# 水印与验收报告 PDF 都需要中文字体。字体缺失时**直接失败**，
# 不产出「看起来正常但没有水印/中文变方块」的产物（见 CLAUDE.md 第 33/43 条）。
WATERMARK_FONT_FAMILY=Noto Sans CJK SC
WATERMARK_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
WATERMARK_OPACITY=0.75
WATERMARK_POSITION=southeast
# pdfkit 加载 .ttc 要的是**集合内的 postscript 名**，不是字体族名。
# 传族名会报 "Not a supported font format or standard PDF font."（误导性极强）
PDF_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
PDF_FONT_NAME=NotoSansCJKsc-Regular

# ===== 地图服务（高德 / 腾讯）=====
# 需求文档 §4.6.2 / AC-N13：Key 仅存服务端，不下发前端、不写日志。
# MAP_PROVIDER=auto|amap|tencent
#   auto   有高德 Key 用高德，否则用腾讯
#   amap   地理编码 + 驾车路线规划都走高德
#   tencent 仅地理编码走腾讯；路线规划会降级为单点导航
# AMAP_KEY 需要开通「Web 服务」类型 Key（地理编码 + 驾车路径规划）。
# TENCENT_MAP_KEY 需要开通 WebService API（地理编码 / 逆地理编码）；只配腾讯 Key 也能
# 生成签到水印里的文字位置，但驾车路线规划仍需要高德。
MAP_PROVIDER=auto
AMAP_KEY=
TENCENT_MAP_KEY=

# ===== 可靠电子签名（验收单，可选）=====
# 默认关闭：验收走手写签名，仅项目内部确认，不具备法律效力。
# 需要法律效力时设置 ESIGN_ENABLED=true 并配置服务商；开启后生产禁止 mock、禁止手写兜底。
# 腾讯电子签 API 仅专业版/旗舰版支持；当前已实现 provider：tencent / mock。
ESIGN_ENABLED=false
# 服务商故障时的暂停开关：只停新建任务，回调/查单/归档继续
ESIGN_SIGNING_PAUSED=false
# 未启用可靠电子签时必须为 true（否则验收无法完成）；启用后不再使用手写签名
ESIGN_LEGACY_SIGNING=true
ESIGN_PROVIDER=
ESIGN_APP_ID=
ESIGN_APP_SECRET=
# 腾讯电子签发起人 UserId / 企业 OrganizationId；其它服务商可留空
ESIGN_OPERATOR_ID=
ESIGN_ORGANIZATION_ID=
ESIGN_REGION=
ESIGN_API_BASE=
# 生产必须是 https，并在服务商控制台配置回调
ESIGN_CALLBACK_URL=
ESIGN_CALLBACK_SECRET=
# 密钥轮换期间的上一把；没有就留空
ESIGN_CALLBACK_SECRET_PREVIOUS=
# 可选，逗号分隔；为空表示只依赖验签
ESIGN_CALLBACK_IPS=
# 私有存储目录，必须不在 UPLOAD_DIR 内；生产建议放到独立磁盘/对象存储
ESIGN_PRIVATE_DIR=./private-esign
ESIGN_SIGN_TTL_SECONDS=604800
ESIGN_REFRESH_MIN_INTERVAL_SECONDS=10
ESIGN_CREATE_TIMEOUT_MS=10000
ESIGN_MAX_DOCUMENT_MB=20
ESIGN_CONSENT_VERSION=2026-10-v1

# ===== 日志 =====
# debug | info | warn | error
LOG_LEVEL=info

# ===== 门锁密码加密密钥（§4.8.3 / AC-K10）=====
# 需求文档 §4.8 的门锁密码是**可逆加密**存储的（AES-256-GCM）——
# 工长与监理要看到明文，因此不能用 bcrypt 那类单向哈希。
#
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 三条必须记住的：
#   1. 生产环境**未配置此值时服务拒绝启动**（server.js 的启动自检）。
#      这不是洁癖：缺密钥时若静默降级成一个派生密钥，部署的人不会发现，
#      直到有人发现所有业主家的门锁密码都用一个公开在源码里的密钥加密。
#   2. **密钥丢失 = 所有已存的门锁密码永久不可恢复**，只能让业主重新设置。
#      因此它必须和数据库备份分开保管（同库备份等于没做密钥分离）。
#   3. 它不进数据库、不进仓库、不进日志。本文件里永远留空。
DOOR_CODE_KEY=
