{
  "name": "renovation-server",
  "version": "0.1.0",
  "private": true,
  "description": "工程宝 · 后端服务（Express + JavaScript）",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch src --watch config src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:test": "cross-env NODE_ENV=test node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:all": "vitest run --no-file-parallelism",
    "smoke": "node scripts/smoke.js",
    "check:real-name": "node scripts/check-real-name.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.12.0",
    "nanoid": "^3.3.8",
    "pdfkit": "^0.15.2",
    "sharp": "^0.33.5",
    "svg-captcha": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "allure-commandline": "2.46.1",
    "allure-vitest": "3.0.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
