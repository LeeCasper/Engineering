[Unit]
Description=Renovation pull deployment (origin/main -> /srv/renovation/app)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/renovation-deploy.sh
TimeoutStartSec=1800
Nice=10
# 输出写入独立文件；journald 仍保留 unit 的启动/失败结果（systemctl status / journalctl -u）
StandardOutput=append:/var/log/renovation/deploy.log
StandardError=append:/var/log/renovation/deploy.log
